page {
  background: #0f172a;
  color: #f8fafc;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.card {
  width: 100%;
  max-width: 680rpx;
  background: linear-gradient(160deg, #1e293b, #0b1220);
  border-radius: 24rpx;
  padding: 40rpx;
  box-sizing: border-box;
  box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, 0.3);
}

.title {
  font-size: 52rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.subtitle {
  color: #cbd5e1;
  font-size: 28rpx;
  margin-bottom: 40rpx;
}

.primary-btn {
  background: #f59e0b;
  color: #111827;
  font-weight: 700;
  margin-bottom: 24rpx;
}

.secondary-btn {
  background: transparent;
  color: #f8fafc;
  border: 2rpx solid #475569;
}
