.home-page {
  min-height: 100vh;
  padding: 72rpx 44rpx;
  box-sizing: border-box;
  background: radial-gradient(circle at top, #2d1f16 0%, #120f0d 52%, #0a0908 100%);
  position: relative;
  overflow: hidden;
}

.mist {
  position: absolute;
  top: -120rpx;
  left: -120rpx;
  width: 520rpx;
  height: 520rpx;
  background: radial-gradient(circle, rgba(238, 212, 176, 0.16), rgba(0, 0, 0, 0));
}

.hero-card {
  position: relative;
  margin-top: 140rpx;
  border: 1rpx solid rgba(212, 170, 103, 0.45);
  border-radius: 20rpx;
  padding: 56rpx 38rpx;
  background: rgba(20, 16, 12, 0.86);
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.35);
}

.game-title {
  text-align: center;
  color: #e7c998;
  font-size: 62rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  margin-bottom: 28rpx;
}

.game-copy {
  color: #e9d7bb;
  font-size: 28rpx;
  line-height: 1.8;
  text-align: center;
  margin-bottom: 58rpx;
}

.start-btn {
  background: linear-gradient(180deg, #dcb57a, #ad7a3f);
  color: #20140b;
  font-weight: 700;
  border: none;
  margin-bottom: 26rpx;
}

.sect-btn {
  background: transparent;
  color: #e7c998;
  border: 2rpx solid rgba(212, 170, 103, 0.75);
}
